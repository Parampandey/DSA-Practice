class Solution:
    def isAnagram(self, s: str, t: str) -> bool:
      #  return Counter(s)==Counter(t) first direct solution .Counter automatically count the no of chacter in a string and its repetion 
      # now using hashmap /dictonary

       countS,countT={},{}
       if len(s)!=len(t):
         return False
       for ch in s: # here we add the element in dict or hashmap
        countS[ch]=1+countS.get(ch,0) # countS.get means return the value of ch if not found return zero ,and add this char feq 1 and if found add 1 to the prev freq
       for ch in t:
         countT[ch]=1+countT.get(ch,0)


       for ch in countS:# here i check the freq is same of not
        if countS[ch]!=countT.get(ch,0):
            return False
       return True
         
