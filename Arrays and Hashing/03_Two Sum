class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        map={} # store nums element  in value:index
        for i ,n in enumerate(nums):# enumerate function store or print the array in the form of (index ,value) for each item here i index and n is no in array. if arr=[2,3,4] then print enumerate(arr) output= (0 2) (1 3) (2 4) in tuple index and value
          diff=target-n
          if diff in map:
            return [map[diff],i]
          map[n]=i # if no not present in map add to it
        return
